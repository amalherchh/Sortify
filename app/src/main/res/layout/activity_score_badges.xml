<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header with Back Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/buttonBackProfile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="←"
                android:textSize="18sp"
                android:backgroundTint="#757575"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Your Impact"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:gravity="center" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp" />

        </LinearLayout>

        <!-- User Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#E8F5E9"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/textViewUserName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="User Name"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:gravity="center"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/textViewUserEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="user@email.com"
                android:textSize="12sp"
                android:textColor="#666666"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#C8E6C9"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Items Sorted"
                        android:textSize="11sp"
                        android:textColor="#666666"
                        android:gravity="center"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/textViewItemsCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1B5E20"
                        android:gravity="center" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="40dp"
                    android:background="#C8E6C9"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total Points"
                        android:textSize="11sp"
                        android:textColor="#666666"
                        android:gravity="center"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/textViewTotalScore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0 pts"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1B5E20"
                        android:gravity="center" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Progress Bar Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Progress to Next Badge"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#555555"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFF8E1"
            android:padding="14dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/textViewCurrentBadgeLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Current Level: Beginner"
                android:textSize="12sp"
                android:textColor="#5D4037"
                android:layout_marginBottom="8dp" />

            <ProgressBar
                android:id="@+id/progressBarScore"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:progress="0"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textViewProgressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0/50 points to Eco-Learner"
                android:textSize="11sp"
                android:textColor="#666666" />

        </LinearLayout>

        <!-- Badges Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Achievement Badges"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#555555"
            android:layout_marginBottom="16dp" />

        <!-- Badge 1: Beginner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#E8F5E9"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="🌱"
                    android:textSize="40sp"
                    android:gravity="center"
                    android:layout_marginRight="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Beginner"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1B5E20"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0-50 points"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/textViewBadge1Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✓ Earned"
                        android:textSize="11sp"
                        android:textColor="#2E7D32"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Badge 2: Eco-Learner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#C8E6C9"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="♻️"
                    android:textSize="40sp"
                    android:gravity="center"
                    android:layout_marginRight="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Eco-Learner"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1B5E20"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="50-100 points"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/textViewBadge2Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="In Progress..."
                        android:textSize="11sp"
                        android:textColor="#F57C00"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Badge 3: Recycling Hero -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="🏆"
                    android:textSize="40sp"
                    android:gravity="center"
                    android:layout_marginRight="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Recycling Hero"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#666666"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="100+ points"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/textViewBadge3Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Locked"
                        android:textSize="11sp"
                        android:textColor="#999999"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/buttonSortMore"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Sort More Items"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#1B5E20"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/buttonShareBadge"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Share My Progress"
            android:textSize="14sp"
            android:backgroundTint="#A5D6A7"
            android:textColor="#1B5E20" />
        <!-- Logout Button -->
        <Button
            android:id="@+id/buttonLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🚪 Logout"
            android:textSize="14sp"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</ScrollView>