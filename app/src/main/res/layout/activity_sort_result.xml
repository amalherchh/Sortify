<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="SORTIFY"
            android:textColor="#1B5E20"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Waste Management"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:textColor="#666666" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sustainable disposal for Tunisia"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:textColor="#999999" />

        <!-- Back Button -->
        <Button
            android:id="@+id/buttonBack"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="← Back"
            android:textSize="14sp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#757575"
            android:textColor="#FFFFFF" />

        <!-- Input Summary -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item Sorted"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#555555"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textViewItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[Item name]"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:textColor="#1B5E20" />

        <!-- Waste Category Card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waste Category"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:textColor="#555555" />

        <TextView
            android:id="@+id/textViewCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Category will appear here"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="14dp"
            android:layout_marginBottom="20dp"
            android:background="#F5F5F5"
            android:textColor="#1B5E20" />

        <!-- Disposal Instructions Card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disposal Instructions"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:textColor="#555555" />

        <TextView
            android:id="@+id/textViewInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Step-by-step disposal guidance will appear here"
            android:textSize="13sp"
            android:padding="14dp"
            android:layout_marginBottom="20dp"
            android:background="#FFF8E1"
            android:textColor="#5D4037"
            android:lineSpacingExtra="4dp" />

        <!-- Environmental Impact Card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Environmental Impact"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:textColor="#555555" />

        <TextView
            android:id="@+id/textViewImpact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Learn how proper disposal helps Tunisia's environment"
            android:textSize="13sp"
            android:padding="14dp"
            android:layout_marginBottom="24dp"
            android:background="#E8F5E9"
            android:textColor="#2E7D32"
            android:lineSpacingExtra="4dp" />

        <!-- Sort Another Button -->
        <Button
            android:id="@+id/buttonSortAnother"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Sort Another Item"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#1B5E20"
            android:textColor="#FFFFFF" />

        <!-- Footer Info -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SORTIFY helps you manage waste sustainably."
            android:textSize="10sp"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="#999999"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>

</ScrollView>